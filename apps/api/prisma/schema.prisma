// La URL de conexión NO vive aquí (Prisma 7 ya no lo permite): para Migrate
// está en prisma.config.ts, y en runtime la pasa el driver adapter en
// src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Los identificadores de enum de Prisma no admiten tildes; @map conserva el
// valor real (con tilde) en la columna de Postgres y en el dominio
// (packages/domain/src/state-machine/factura-estado.ts).
enum FacturaEstado {
  recibida
  procesando
  extraida          @map("extraída")
  necesita_revision @map("necesita_revisión")
  fallida
  varias_facturas
}

enum MedioPago {
  efectivo
  tarjeta_debito
  tarjeta_credito
  transferencia_pse
  billetera_digital
}

enum CufeOrigen {
  qr
  ocr_respaldo
}

// Taxonomía cerrada — constitution Principio IV.
enum TipoDocumento {
  factura_electronica
  documento_equivalente_pos
  documento_soporte
  otro
  desconocido
}

// specs/006-multi-usuario: modelos de Better Auth (research.md § 1). Nombres
// de modelo en inglés porque el adaptador de Prisma de Better Auth los
// invoca así (prisma.user.*, prisma.session.*, etc.) — @@map sí se traduce,
// porque solo renombra la tabla real en Postgres, no el cliente generado.
model User {
  id            String   @id @default(uuid())
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Reemplaza la variable de entorno MIS_IDENTIFICACIONES (FR-007) — propia de cada cuenta. `input: false` en la config de Better Auth: nunca se fija en el registro, solo vía PUT /cuenta/identificaciones (US2).
  identificacionesTributarias String[] @default([])

  sessions Session[]
  accounts Account[]
  facturas Factura[]

  @@unique([email])
  @@map("usuarios")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([token])
  @@map("sesiones")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  /// Hash de contraseña cuando providerId = "credential" (correo/contraseña, sin OAuth) — nunca en texto plano.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("cuentas_auth")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verificaciones")
}

// Campos de captura (US1) + extracción (US2) + clasificación tributaria
// (US3). El soft-delete (eliminadaEn) se agrega en specs/002-rediseno-visual-web
// User Story 2 — ver data-model.md de esa feature.
model Factura {
  id                 String        @id @default(uuid())
  estado             FacturaEstado @default(recibida)
  rutaImagenOriginal String

  /// Dueño de la factura — quien la capturó (specs/006-multi-usuario, FR-002). Obligatoria desde la migración usuario_id_obligatorio (tras scripts/migrar-datos-existentes.ts, que asignó dueño a las facturas ya existentes). Sin onDelete: Cascade a propósito (constitution Principio I) — eliminar una cuenta con facturas queda fuera de alcance hasta decidir explícitamente qué pasa con la evidencia.
  usuarioId String
  usuario   User  @relation(fields: [usuarioId], references: [id])
  /// Array de { ruta, tipoTransformacion, creadoEn } — ver ArchivoDerivado en el dominio.
  derivados          Json          @default("[]")

  comercioNombre  String?
  comercioNIT     String?
  fechaHoraCompra DateTime?
  moneda          String    @default("COP")

  subtotalCentavos        Int?
  /// Array de { tarifa, valorCentavos } — ver IvaTarifa en el dominio.
  ivaPorTarifa            Json    @default("[]")
  impuestoConsumoCentavos Int?
  propinaCentavos         Int?
  totalCentavos           Int?

  medioPago                 MedioPago?
  adquirienteNombre         String?
  adquirienteIdentificacion String?

  cufe       String?
  cufeOrigen CufeOrigen?

  /// Mapa { nombreCampo: nivelConfianza (0-1) } — ver ConfianzaCampos en el dominio.
  confianzaCampos Json @default("{}")

  tipoDocumento          TipoDocumento?
  /// Siempre CALCULADO por la regla de elegibilidad (FR-016) — nunca se escribe desde otra ruta.
  elegibilidadTributaria Boolean?
  elegibilidadMotivo     String?

  /// minúsculas/sin tildes/sin puntuación, calculado en JS al guardar — insumo de la coincidencia difusa por pg_trgm (research.md § 6). Nunca se expone tal cual, solo se usa para comparar.
  comercioNombreNormalizado String?

  items               ItemFactura[]
  correcciones        CorreccionManual[]
  extraccionesCrudas  ExtraccionCruda[]
  marcasComoOriginal  MarcaPosibleDuplicado[] @relation("FacturaOriginal")
  marcasComoCandidata MarcaPosibleDuplicado[] @relation("FacturaCandidata")
  validacionesDian    ValidacionDian[]

  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  /// Soft-delete (constitution Principio I / FR-009): ortogonal a `estado`, nunca purgado. No nulo = excluido de toda lectura por defecto.
  eliminadaEn DateTime?

  @@map("facturas")
}

model ItemFactura {
  id        String  @id @default(uuid())
  facturaId String
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  descripcion           String?
  cantidad              Float?
  valorUnitarioCentavos Int?
  valorTotalCentavos    Int?
  nivelConfianza        Float   @default(0)

  @@map("items_factura")
}

// Registro de un campo editado por el usuario, diferenciado del valor
// extraído — data-model.md § Corrección Manual, FR-011/FR-012.
model CorreccionManual {
  id        String  @id @default(uuid())
  facturaId String
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  campo                 String
  valorExtraidoOriginal String
  valorCorregido        String

  corregidoEn DateTime @default(now())

  @@map("correcciones_manuales")
}

// Exigida por la constitution (Principio III), no por el spec de negocio:
// preserva la salida cruda del proveedor de extracción para permitir
// reprocesamiento futuro sin volver a fotografiar nada.
model ExtraccionCruda {
  id        String  @id @default(uuid())
  facturaId String
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  jsonCrudo     Json
  versionPrompt String
  versionModelo String

  creadaEn DateTime @default(now())

  @@map("extracciones_crudas")
}

enum MetodoDeteccionDuplicado {
  cufe_exacto
  comercio_fecha_total_similar
}

enum EstadoMarcaDuplicado {
  duplicado_confirmado
  pendiente_confirmacion
  confirmado_distinto
}

// Relación entre dos facturas que el sistema considera la misma compra —
// data-model.md § Marca de Posible Duplicado, FR-019/FR-020. Ortogonal a
// Factura.estado: no comparte máquina de estados con el pipeline de extracción.
model MarcaPosibleDuplicado {
  id String @id @default(uuid())

  facturaOriginalId  String
  facturaOriginal    Factura @relation("FacturaOriginal", fields: [facturaOriginalId], references: [id], onDelete: Cascade)
  facturaCandidataId String
  facturaCandidata   Factura @relation("FacturaCandidata", fields: [facturaCandidataId], references: [id], onDelete: Cascade)

  metodoDeteccion MetodoDeteccionDuplicado
  estado          EstadoMarcaDuplicado @default(pendiente_confirmacion)
  resueltoEn      DateTime?

  creadaEn DateTime @default(now())

  @@map("marcas_posible_duplicado")
}

enum MetodoValidacionDian {
  manual
  conciliacion
}

enum ResultadoValidacionDian {
  valido_vigente
  no_encontrado
  anulado_reemplazado
  otro
}

// Registro de auditoría de que el usuario (o la conciliación en lote)
// confirmó el estado de un CUFE contra la DIAN — data-model.md,
// specs/003-validacion-dian. Append-only: nunca se edita ni se borra un
// registro ya creado, uno nuevo es un registro nuevo. Ortogonal a
// Factura.estado y MUST NOT alimentar elegibilidadTributaria/tipoDocumento
// (constitution Principio IV) — es información complementaria, no una
// entrada del cálculo de elegibilidad.
model ValidacionDian {
  id String @id @default(uuid())

  facturaId String
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  metodo    MetodoValidacionDian
  resultado ResultadoValidacionDian

  /// Copia de los campos de Factura en el momento de la validación — nunca datos leídos del portal DIAN (research.md § 2).
  snapshotComercioNombre  String?
  snapshotTotalCentavos   Int?
  snapshotMoneda          String
  snapshotFechaHoraCompra DateTime?
  snapshotCufe            String

  creadaEn DateTime @default(now())

  @@map("validaciones_dian")
}
