// La URL de conexión NO vive aquí (Prisma 7 ya no lo permite): para Migrate
// está en prisma.config.ts, y en runtime la pasa el driver adapter en
// src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Los identificadores de enum de Prisma no admiten tildes; @map conserva el
// valor real (con tilde) en la columna de Postgres y en el dominio
// (packages/domain/src/state-machine/factura-estado.ts).
enum FacturaEstado {
  recibida
  procesando
  extraida          @map("extraída")
  necesita_revision @map("necesita_revisión")
  fallida
}

enum MedioPago {
  efectivo
  tarjeta_debito
  tarjeta_credito
  transferencia_pse
  billetera_digital
}

enum CufeOrigen {
  qr
  ocr_respaldo
}

// Taxonomía cerrada — constitution Principio IV.
enum TipoDocumento {
  factura_electronica
  documento_equivalente_pos
  documento_soporte
  otro
  desconocido
}

// Campos de captura (US1) + extracción (US2) + clasificación tributaria
// (US3). El soft-delete se agrega en User Story 4/5 — ver data-model.md.
model Factura {
  id                 String        @id @default(uuid())
  estado             FacturaEstado @default(recibida)
  rutaImagenOriginal String
  /// Array de { ruta, tipoTransformacion, creadoEn } — ver ArchivoDerivado en el dominio.
  derivados          Json          @default("[]")

  comercioNombre  String?
  comercioNIT     String?
  fechaHoraCompra DateTime?
  moneda          String    @default("COP")

  subtotalCentavos        Int?
  /// Array de { tarifa, valorCentavos } — ver IvaTarifa en el dominio.
  ivaPorTarifa            Json    @default("[]")
  impuestoConsumoCentavos Int?
  propinaCentavos         Int?
  totalCentavos           Int?

  medioPago                 MedioPago?
  adquirienteNombre         String?
  adquirienteIdentificacion String?

  cufe       String?
  cufeOrigen CufeOrigen?

  /// Mapa { nombreCampo: nivelConfianza (0-1) } — ver ConfianzaCampos en el dominio.
  confianzaCampos Json @default("{}")

  tipoDocumento          TipoDocumento?
  /// Siempre CALCULADO por la regla de elegibilidad (FR-016) — nunca se escribe desde otra ruta.
  elegibilidadTributaria Boolean?
  elegibilidadMotivo     String?

  items               ItemFactura[]
  correcciones        CorreccionManual[]
  extraccionesCrudas  ExtraccionCruda[]

  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  @@map("facturas")
}

model ItemFactura {
  id        String  @id @default(uuid())
  facturaId String
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  descripcion           String?
  cantidad              Float?
  valorUnitarioCentavos Int?
  valorTotalCentavos    Int?
  nivelConfianza        Float   @default(0)

  @@map("items_factura")
}

// Registro de un campo editado por el usuario, diferenciado del valor
// extraído — data-model.md § Corrección Manual, FR-011/FR-012.
model CorreccionManual {
  id        String  @id @default(uuid())
  facturaId String
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  campo                 String
  valorExtraidoOriginal String
  valorCorregido        String

  corregidoEn DateTime @default(now())

  @@map("correcciones_manuales")
}

// Exigida por la constitution (Principio III), no por el spec de negocio:
// preserva la salida cruda del proveedor de extracción para permitir
// reprocesamiento futuro sin volver a fotografiar nada.
model ExtraccionCruda {
  id        String  @id @default(uuid())
  facturaId String
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  jsonCrudo     Json
  versionPrompt String
  versionModelo String

  creadaEn DateTime @default(now())

  @@map("extracciones_crudas")
}
