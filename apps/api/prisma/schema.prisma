// La URL de conexión NO vive aquí (Prisma 7 ya no lo permite): para Migrate
// está en prisma.config.ts, y en runtime la pasa el driver adapter en
// src/prisma/prisma.service.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Los identificadores de enum de Prisma no admiten tildes; @map conserva el
// valor real (con tilde) en la columna de Postgres y en el dominio
// (packages/domain/src/state-machine/factura-estado.ts).
enum FacturaEstado {
  recibida
  procesando
  extraida          @map("extraída")
  necesita_revision @map("necesita_revisión")
  fallida
  varias_facturas
}

enum MedioPago {
  efectivo
  tarjeta_debito
  tarjeta_credito
  transferencia_pse
  billetera_digital
}

enum CufeOrigen {
  qr
  ocr_respaldo
}

// Taxonomía cerrada — constitution Principio IV.
enum TipoDocumento {
  factura_electronica
  documento_equivalente_pos
  documento_soporte
  otro
  desconocido
}

// Campos de captura (US1) + extracción (US2) + clasificación tributaria
// (US3). El soft-delete (eliminadaEn) se agrega en specs/002-rediseno-visual-web
// User Story 2 — ver data-model.md de esa feature.
model Factura {
  id                 String        @id @default(uuid())
  estado             FacturaEstado @default(recibida)
  rutaImagenOriginal String
  /// Array de { ruta, tipoTransformacion, creadoEn } — ver ArchivoDerivado en el dominio.
  derivados          Json          @default("[]")

  comercioNombre  String?
  comercioNIT     String?
  fechaHoraCompra DateTime?
  moneda          String    @default("COP")

  subtotalCentavos        Int?
  /// Array de { tarifa, valorCentavos } — ver IvaTarifa en el dominio.
  ivaPorTarifa            Json    @default("[]")
  impuestoConsumoCentavos Int?
  propinaCentavos         Int?
  totalCentavos           Int?

  medioPago                 MedioPago?
  adquirienteNombre         String?
  adquirienteIdentificacion String?

  cufe       String?
  cufeOrigen CufeOrigen?

  /// Mapa { nombreCampo: nivelConfianza (0-1) } — ver ConfianzaCampos en el dominio.
  confianzaCampos Json @default("{}")

  tipoDocumento          TipoDocumento?
  /// Siempre CALCULADO por la regla de elegibilidad (FR-016) — nunca se escribe desde otra ruta.
  elegibilidadTributaria Boolean?
  elegibilidadMotivo     String?

  /// minúsculas/sin tildes/sin puntuación, calculado en JS al guardar — insumo de la coincidencia difusa por pg_trgm (research.md § 6). Nunca se expone tal cual, solo se usa para comparar.
  comercioNombreNormalizado String?

  items               ItemFactura[]
  correcciones        CorreccionManual[]
  extraccionesCrudas  ExtraccionCruda[]
  marcasComoOriginal  MarcaPosibleDuplicado[] @relation("FacturaOriginal")
  marcasComoCandidata MarcaPosibleDuplicado[] @relation("FacturaCandidata")

  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  /// Soft-delete (constitution Principio I / FR-009): ortogonal a `estado`, nunca purgado. No nulo = excluido de toda lectura por defecto.
  eliminadaEn DateTime?

  @@map("facturas")
}

model ItemFactura {
  id        String  @id @default(uuid())
  facturaId String
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  descripcion           String?
  cantidad              Float?
  valorUnitarioCentavos Int?
  valorTotalCentavos    Int?
  nivelConfianza        Float   @default(0)

  @@map("items_factura")
}

// Registro de un campo editado por el usuario, diferenciado del valor
// extraído — data-model.md § Corrección Manual, FR-011/FR-012.
model CorreccionManual {
  id        String  @id @default(uuid())
  facturaId String
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  campo                 String
  valorExtraidoOriginal String
  valorCorregido        String

  corregidoEn DateTime @default(now())

  @@map("correcciones_manuales")
}

// Exigida por la constitution (Principio III), no por el spec de negocio:
// preserva la salida cruda del proveedor de extracción para permitir
// reprocesamiento futuro sin volver a fotografiar nada.
model ExtraccionCruda {
  id        String  @id @default(uuid())
  facturaId String
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  jsonCrudo     Json
  versionPrompt String
  versionModelo String

  creadaEn DateTime @default(now())

  @@map("extracciones_crudas")
}

enum MetodoDeteccionDuplicado {
  cufe_exacto
  comercio_fecha_total_similar
}

enum EstadoMarcaDuplicado {
  duplicado_confirmado
  pendiente_confirmacion
  confirmado_distinto
}

// Relación entre dos facturas que el sistema considera la misma compra —
// data-model.md § Marca de Posible Duplicado, FR-019/FR-020. Ortogonal a
// Factura.estado: no comparte máquina de estados con el pipeline de extracción.
model MarcaPosibleDuplicado {
  id String @id @default(uuid())

  facturaOriginalId  String
  facturaOriginal    Factura @relation("FacturaOriginal", fields: [facturaOriginalId], references: [id], onDelete: Cascade)
  facturaCandidataId String
  facturaCandidata   Factura @relation("FacturaCandidata", fields: [facturaCandidataId], references: [id], onDelete: Cascade)

  metodoDeteccion MetodoDeteccionDuplicado
  estado          EstadoMarcaDuplicado @default(pendiente_confirmacion)
  resueltoEn      DateTime?

  creadaEn DateTime @default(now())

  @@map("marcas_posible_duplicado")
}
