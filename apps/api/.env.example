# Validado al arranque con Zod — ver src/config/env.schema.ts
NODE_ENV=development
PORT=3000
# El usuario/password/db deben coincidir con el .env de la raíz (docker-compose.yml)
DATABASE_URL=postgresql://myivo:changeme@localhost:5432/myivo

# Carpeta donde se guardan las fotos originales (montada como volumen Docker
# en producción — ver docker-compose.yml `invoice_images`).
IMAGE_STORAGE_PATH=./data/invoices

# specs/006-multi-usuario — Better Auth. BETTER_AUTH_SECRET: un valor
# aleatorio de al menos 32 caracteres. BETTER_AUTH_URL: la URL pública donde
# corre esta API (Better Auth la usa para construir el enlace de
# verificación en el correo). WEB_ORIGIN: el origen exacto desde donde carga
# el frontend — Better Auth rechaza por CSRF cualquier request cuyo Origin
# no esté aquí.
BETTER_AUTH_SECRET=reemplaza-esto-con-un-valor-aleatorio-de-al-menos-32-caracteres
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# Resend, para el correo de verificación de cuenta nueva (research.md § 2).
# Crea una cuenta gratuita en resend.com. Sin dominio propio verificado, solo
# puedes mandar correos al mismo correo con el que te registraste en Resend
# — usa onboarding@resend.dev como remitente mientras tanto; para que
# cualquier persona pueda registrarse de verdad, verifica tu propio dominio.
RESEND_API_KEY=reemplaza-esto-con-tu-api-key-de-resend
EMAIL_FROM="MyIvo <onboarding@resend.dev>"

# Login social (opcional, cada proveedor por separado — solo se activa si
# tiene AMBAS variables). URL de redirección a registrar en cada consola:
# {BETTER_AUTH_URL}/callback/{proveedor} — con nuestro basePath: '/auth',
# NO es /api/auth/callback/... como muestran los ejemplos genéricos de la
# documentación de Better Auth.
#
# Google — console.cloud.google.com, credenciales OAuth 2.0 tipo "Web
# application". Redirect URI (dev): http://localhost:3000/auth/callback/google
GOOGLE_CLIENT_ID=reemplaza-esto-con-tu-client-id-de-google
GOOGLE_CLIENT_SECRET=reemplaza-esto-con-tu-client-secret-de-google
# Microsoft — entra.microsoft.com (Entra ID / Azure AD), registro de app.
# Redirect URI (dev): http://localhost:3000/auth/callback/microsoft
# Nota: cuentas "managed"/de trabajo no siempre mandan el correo, y cuando
# lo mandan no viene verificado por Microsoft — puede quedar pendiente de
# verificación igual que un registro por correo/contraseña.
MICROSOFT_CLIENT_ID=reemplaza-esto-con-tu-client-id-de-microsoft
MICROSOFT_CLIENT_SECRET=reemplaza-esto-con-tu-client-secret-de-microsoft
# GitHub — github.com/settings/developers, OAuth App (no GitHub App, así no
# hay que configurar permisos de correo aparte). Callback URL (dev):
# http://localhost:3000/auth/callback/github
# Nota: una cuenta con correo privado en GitHub puede no mandar ninguno.
GITHUB_CLIENT_ID=reemplaza-esto-con-tu-client-id-de-github
GITHUB_CLIENT_SECRET=reemplaza-esto-con-tu-client-secret-de-github

# Proveedor y modelo de extracción (FR-031, research.md § 10). Cambiar de
# proveedor es cambiar estas dos líneas + su API key — sin tocar código.
# EXTRACTION_PROVIDER: claude | openai | gemini | zai | qwen | kimi | openrouter | deepseek
# Solo se exige la API key del proveedor activo (ver env.schema.ts).
# deepseek está en el código pero deshabilitado: su API pública todavía no
# soporta imágenes (ver extraction.module.ts).
EXTRACTION_PROVIDER=claude
EXTRACTION_MODEL=claude-sonnet-5

# Claude (Anthropic) — generar en platform.claude.com
ANTHROPIC_API_KEY=reemplaza-esto-con-tu-api-key-de-anthropic
# OpenAI — generar en platform.openai.com. Modelo de ejemplo: gpt-5.5
OPENAI_API_KEY=reemplaza-esto-con-tu-api-key-de-openai
# Google Gemini — generar en Google AI Studio. Modelo de ejemplo: gemini-3-pro-preview
GEMINI_API_KEY=reemplaza-esto-con-tu-api-key-de-gemini
# Z.ai (GLM) — generar en z.ai. Modelo de ejemplo: glm-5v-turbo
ZAI_API_KEY=reemplaza-esto-con-tu-api-key-de-zai
# Qwen (Alibaba Cloud / DashScope) — el baseURL varía según la región de tu
# cuenta (ver openai-compatible-invoice-extractor.adapter.ts). Modelo de ejemplo: qwen3-vl-plus
QWEN_API_KEY=reemplaza-esto-con-tu-api-key-de-dashscope
# Kimi (Moonshot AI) — generar en platform.kimi.ai/moonshot.ai. Modelo de ejemplo: kimi-k3
KIMI_API_KEY=reemplaza-esto-con-tu-api-key-de-kimi
# OpenRouter — agregador con acceso a muchos modelos abiertos con visión
# (Qwen3-VL, GLM, Llama...) bajo una sola cuenta. Generar en openrouter.ai.
# Modelo de ejemplo: qwen/qwen3.7-flash (verifica el catálogo vigente en
# openrouter.ai/models — cambia seguido).
OPENROUTER_API_KEY=reemplaza-esto-con-tu-api-key-de-openrouter
# DeepSeek — preparado pero rechazado explícitamente hasta que su API
# pública soporte imágenes.
DEEPSEEK_API_KEY=reemplaza-esto-con-tu-api-key-de-deepseek

# Nota: los nombres de modelo de arriba son los vigentes en agosto 2026 —
# estos proveedores los cambian con frecuencia, verifica el actual en su
# documentación.
