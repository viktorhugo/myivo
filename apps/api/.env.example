# Validado al arranque con Zod — ver src/config/env.schema.ts
NODE_ENV=development
PORT=3000
# El usuario/password/db deben coincidir con el .env de la raíz (docker-compose.yml)
DATABASE_URL=postgresql://myivo:changeme@localhost:5432/myivo
SESSION_SECRET=reemplaza-esto-con-un-valor-aleatorio-de-al-menos-32-caracteres

# Credenciales del único usuario (FR-030). AUTH_PASSWORD_HASH es un hash Argon2,
# nunca la contraseña en texto plano. Genéralo con:
#   node -e "require('argon2').hash('tu-contraseña').then(console.log)"
AUTH_USERNAME=victor
AUTH_PASSWORD_HASH=reemplaza-esto-con-el-hash-argon2-generado

# Carpeta donde se guardan las fotos originales (montada como volumen Docker
# en producción — ver docker-compose.yml `invoice_images`).
IMAGE_STORAGE_PATH=./data/invoices
