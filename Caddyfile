{
	email {$CADDY_ACME_EMAIL}
}

# {$APP_DOMAIN} se define como variable de entorno al desplegar (p. ej. facturas.tudominio.com).
# Caddy obtiene y renueva el certificado TLS automáticamente para ese dominio.
{$APP_DOMAIN} {
	encode gzip

	# Backend NestJS. handle_path (no handle) quita el prefijo /api antes de
	# reenviar — ningún @Controller() de apps/api está montado bajo /api (ver
	# el comentario de apps/api/src/main.ts): con `handle` a secas, cada
	# request llegaría como /api/invoices y NestJS respondería 404 porque su
	# ruta real es /invoices.
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# SPA de apps/web ya compilada (vite build), copiada a /srv/web en el contenedor de Caddy.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
