# docker-compose.yml — servicio postgres. En producción, docker-compose.yml
# ya arma DATABASE_URL del contenedor `api` a partir de estas 3 variables
# (apuntando al servicio `postgres` por nombre, no a localhost) — no hace
# falta mantenerlas sincronizadas a mano con apps/api/.env.
POSTGRES_USER=myivo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=myivo

# Caddyfile — DEBEN cambiar en producción (localhost/un correo de ejemplo no
# sirven para pedir un certificado TLS real):
# APP_DOMAIN: tu dominio real (ej. facturas.tudominio.com), con su registro
#   DNS ya apuntando a este VPS.
# CADDY_ACME_EMAIL: un correo real tuyo — Let's Encrypt lo usa para avisar
#   antes de que un certificado expire, no para nada más.
APP_DOMAIN=localhost
CADDY_ACME_EMAIL=tu-correo@ejemplo.com
