# docker-compose.yml — servicio postgres. En producción, docker-compose.yml
# ya arma DATABASE_URL del contenedor `api` a partir de estas 3 variables
# (apuntando al servicio `postgres` por nombre, no a localhost) — no hace
# falta mantenerlas sincronizadas a mano con apps/api/.env.
POSTGRES_USER=myivo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=myivo

# Caddyfile — DEBEN cambiar en producción (localhost/un correo de ejemplo no
# sirven para pedir un certificado TLS real):
# APP_DOMAIN: tu dominio real (ej. facturas.tudominio.com), con su registro
#   DNS ya apuntando a este VPS.
# CADDY_ACME_EMAIL: un correo real tuyo — Let's Encrypt lo usa para avisar
#   antes de que un certificado expire, no para nada más.
APP_DOMAIN=localhost
CADDY_ACME_EMAIL=tu-correo@ejemplo.com

# scripts/backup-db.sh — respaldo cifrado fuera del servidor (FR-018/FR-018a,
# specs/007-despliegue-produccion). Sin estas dos, el script MUST fallar
# antes de generar cualquier archivo, nunca dejar un respaldo sin cifrar.
#
# MYIVO_BACKUP_ENCRYPTION_KEY: una llave de `age` (`age-keygen -o llave.txt`
#   te da un `AGE-SECRET-KEY-...`; usá ese valor acá). MUST además guardarse
#   vos mismo en un gestor de contraseñas, fuera de este servidor — si el VPS
#   se pierde, esta es la única copia que puede haber quedado, y sin ella el
#   propio respaldo cifrado queda indescifrable para siempre.
# MYIVO_BACKUP_REMOTE: un remoto de `rclone` ya configurado
#   (`rclone config`) apuntando a tu proveedor de almacenamiento de objetos
#   (Backblaze B2, o cualquier otro compatible con S3), ej.
#   "b2:myivo-backups/produccion".
MYIVO_BACKUP_ENCRYPTION_KEY=reemplaza-esto-con-tu-llave-de-age
MYIVO_BACKUP_REMOTE=reemplaza-esto-con-tu-remoto-de-rclone
